# Required for signed sessions
AUTH_SECRET=replace-with-a-long-random-value
APP_TIME_ZONE=Africa/Johannesburg

# Authenticated SMTP task notifications (server-side only)
SMTP_HOST=smtp.melohospitality.co.za
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=noreply@meloshospitality.co.za
SMTP_PASSWORD=replace-with-the-rotated-smtp-password
SMTP_FROM=noreply@meloshospitality.co.za
